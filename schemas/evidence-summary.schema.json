{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abdullah-x-bd/PipelineProof/schemas/evidence-summary.schema.json",
  "title": "PipelineProof v0.4 evidence summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accepted_valid_controls",
    "broken_tasks",
    "docker_executed",
    "false_accept_trials",
    "false_accepts",
    "false_reject_trials",
    "false_rejects",
    "families",
    "frontier_model_panel",
    "high_variance_cells",
    "invalid_attack_trials",
    "local_docker_disagreements",
    "local_docker_parity_status",
    "model_best_of_n",
    "rejected_broken_tasks",
    "reward_ladder_strictly_monotonic",
    "structural_attack_cells",
    "structural_valid_control_cells",
    "task_count",
    "valid_attack_trials",
    "valid_controls"
  ],
  "properties": {
    "accepted_valid_controls": {"type": "integer", "minimum": 0},
    "broken_tasks": {"type": "integer", "minimum": 0},
    "docker_executed": {"type": "boolean"},
    "false_accept_trials": {"type": "integer", "minimum": 0},
    "false_accepts": {"type": "integer", "minimum": 0},
    "false_reject_trials": {"type": "integer", "minimum": 0},
    "false_rejects": {"type": "integer", "minimum": 0},
    "families": {"type": "integer", "minimum": 1},
    "frontier_model_panel": {"type": "string"},
    "high_variance_cells": {"type": "integer", "minimum": 0},
    "invalid_attack_trials": {"type": "integer", "minimum": 0},
    "local_docker_disagreements": {"type": ["integer", "null"], "minimum": 0},
    "local_docker_parity_status": {"type": "string", "enum": ["complete", "not_run"]},
    "model_best_of_n": {"type": "string"},
    "rejected_broken_tasks": {"type": "integer", "minimum": 0},
    "reward_ladder_strictly_monotonic": {"type": "boolean"},
    "structural_attack_cells": {"type": "integer", "minimum": 1},
    "structural_valid_control_cells": {"type": "integer", "minimum": 1},
    "task_count": {"type": "integer", "minimum": 1},
    "valid_attack_trials": {"type": "integer", "minimum": 0},
    "valid_controls": {"type": "integer", "minimum": 0}
  }
}
